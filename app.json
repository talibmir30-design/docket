{
  "expo": {
    "name": "Docket",
    "slug": "docket",
    "owner": "taliibbmeers-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.talibmir.docket",
      "newArchEnabled": false
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Docket to read screenshots."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Docket to select screenshots."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b03d9c56-ce09-4166-a3e7-086d759d01ad"
      }
    }
  }
}
